+/** One JSON document: every file in the order given, plus the total. */
+export function formatJson(rows: Row[], total: Counts): string {
+  const files = rows.map(({ file, lines, words, bytes }) => ({ file, lines, words, bytes }))
+  return `${JSON.stringify({ files, total })}\n`
+}
+
 function formatRow(counts: Counts, label: string): string {
   return [counts.lines, counts.words, counts.bytes].map((value) => String(value).padStart(8)).join("") + ` ${label}`
 }
