diff --git a/test/lru.test.ts b/test/lru.test.ts
index 21c53cc..7888a19 100644
--- a/test/lru.test.ts
+++ b/test/lru.test.ts
@@ -22,3 +22,48 @@ describe("LruCache", () => {
     expect(() => new LruCache({ max: 0 })).toThrow(RangeError)
   })
 })
+
+describe("LruCache ttl", () => {
+  function clock() {
+    let current = 0
+    return { now: () => current, advance: (ms: number) => void (current += ms) }
+  }
+
+  test("entries expire after the default ttl", () => {
+    const time = clock()
+    const cache = new LruCache<string, number>({ max: 3, ttlMs: 100, now: time.now })
+    cache.set("a", 1)
+    time.advance(50)
+    expect(cache.get("a")).toBe(1)
+    time.advance(60)
+    expect(cache.get("a")).toBeUndefined()
+    expect(cache.has("a")).toBe(false)
+    expect(cache.size).toBe(0)
+  })
+
+  test("a per-entry ttl overrides the default", () => {
+    const time = clock()
+    const cache = new LruCache<string, number>({ max: 3, ttlMs: 100, now: time.now })
+    cache.set("short", 1, 10)
+    time.advance(20)
+    expect(cache.has("short")).toBe(false)
+  })
+
+  test("an expired entry does not push out a live one", () => {
+    const time = clock()
+    const cache = new LruCache<string, number>({ max: 2, now: time.now })
+    cache.set("a", 1, 10)
+    cache.set("b", 2)
+    time.advance(20)
+    cache.set("c", 3)
+    expect(cache.keys()).toEqual(["b", "c"])
+  })
+
+  test("without a ttl nothing expires", () => {
+    const time = clock()
+    const cache = new LruCache<string, number>({ max: 1, now: time.now })
+    cache.set("a", 1)
+    time.advance(10 ** 9)
+    expect(cache.get("a")).toBe(1)
+  })
+})
