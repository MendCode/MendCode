       if (oldest.done) break
@@ -38,7 +53,9 @@ export class LruCache<K, V> {
   }
 
   delete(key: K): boolean {
-    return this.#entries.delete(key)
+    const live = this.#live(key) !== undefined
+    this.#entries.delete(key)
